                /* milestones = [
                    Milestone(title: "목표 체중 설정", description: "건강한 감량 목표 수립"),
                    Milestone(title: "식단 계획", description: "칼로리 계산 및 식단표 작성"),
                    Milestone(title: "운동 루틴 시작", description: "주 4회 유산소+근력 운동"),
                    Milestone(title: "5kg 감량", description: "첫 번째 마일스톤"),
                    Milestone(title: "목표 체중 달성", description: "최종 목표 체중 도달")
                ] */
                height = 3.0
            } else {
                obstacles = [
                    Obstacle(type: .time, description: "건강 관리", currentValue: 0, targetValue: 60, unit: "일"),
                    Obstacle(type: .skill, description: "습관 형성", currentValue: 0, targetValue: 21, unit: "일")
                ] */
                /* milestones = [
                    Milestone(title: "계획 수립", description: "건강 목표 및 실천 계획"),
                    Milestone(title: "습관 만들기", description: "21일 연속 실천"),
                    Milestone(title: "루틴 정착", description: "60일 지속"),
                    Milestone(title: "목표 달성", description: "건강 목표 완수")
                ] */
                height = 2.5
            }
        }
        // 경험 관련
        else if item.category == .experience {
            obstacles = [
                Obstacle(type: .money, description: "필요 비용", currentValue: 0, targetValue: 800000, unit: "원"),
                Obstacle(type: .time, description: "소요 시간", currentValue: 0, targetValue: 10, unit: "시간"),
                Obstacle(type: .knowledge, description: "사전 준비", currentValue: 0, targetValue: 1, unit: "완료")
            ]
            milestones = [
                Milestone(title: "정보 수집", description: "어떻게, 어디서 할 수 있는지 조사"),
                Milestone(title: "예약/신청", description: "체험 예약 또는 신청"),
                Milestone(title: "준비하기", description: "필요한 물품이나 지식 준비"),
                Milestone(title: "실행하기", description: "실제로 경험해보기")
            ]
            height = 1.8
        }
        // 관계 관련
        else if item.category == .relationship {
            obstacles = [
                Obstacle(type: .time, description: "함께하는 시간", currentValue: 0, targetValue: 50, unit: "시간"),
                Obstacle(type: .skill, description: "노력과 실천", currentValue: 0, targetValue: 30, unit: "일")
            ]
            milestones = [
                Milestone(title: "목표 공유", description: "상대방과 목표 이야기하기"),
                Milestone(title: "작은 실천", description: "매일 작은 노력 시작"),
                Milestone(title: "특별한 시간", description: "의미있는 경험 함께하기"),
                Milestone(title: "관계 깊이 다지기", description: "목표 달성 및 관계 발전")
            ]
            height = 2.2
        }
        // 기본 템플릿
        else {
            obstacles = [
                Obstacle(type: .money, description: "필요 비용", currentValue: 0, targetValue: 1000000, unit: "원"),
                Obstacle(type: .time, description: "필요 시간", currentValue: 0, targetValue: 100, unit: "시간"),
                Obstacle(type: .knowledge, description: "학습 및 준비", currentValue: 0, targetValue: 1, unit: "완료")
            ]
            milestones = [
                Milestone(title: "계획 수립", description: "구체적인 실행 계획 세우기"),
                Milestone(title: "준비 시작", description: "필요한 자원 모으기"),
                Milestone(title: "본격 실행", description: "계획 실천하기"),
                Milestone(title: "목표 완수", description: "최종 목표 달성")
            ]
            height = 3.0
        }

        // 업데이트
        if let index = bucketItems.firstIndex(where: { $0.id == item.id }) {
            bucketItems[index].obstacles = obstacles
            // milestones는 generatePresetMilestones에서 따로 생성
            bucketItems[index].mountainHeight = height
            saveData()
        }
    }
    
    private func saveData() {
        if let encoded = try? JSONEncoder().encode(bucketItems) {
            UserDefaults.standard.set(encoded, forKey: saveKey)
        }
    }
    
    private func loadData() {
        if let savedData = UserDefaults.standard.data(forKey: saveKey),
           let decoded = try? JSONDecoder().decode([BucketListItem].self, from: savedData) {
            bucketItems = decoded
        }
    }
    
}
