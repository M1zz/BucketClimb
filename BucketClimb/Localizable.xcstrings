        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimini del tutto il sogno '%@'. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の夢を完全に削除します。この操作は取り消せません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Drømmen «%@» slettes for godt. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' wordt definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Marzenie „%@” zostanie usunięte na zawsze. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sonho '%@' será excluído de vez. Essa ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
