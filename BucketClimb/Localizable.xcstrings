    "열쇠가 완성되면\n상자를 열 수 있어요!": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až bude klíč hotový,\nmůžeš otevřít truhlu!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nøglen er færdig,\nkan du åbne kisten!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist der Schlüssel fertig,\nlässt sich die Truhe öffnen!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το κλειδί είναι έτοιμο,\nμπορείς να ανοίξεις το κουτί!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the key is complete,\nyou can open the box!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the key is complete,\nyou can open the box!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Cuando la llave esté lista,\npodrás abrir el cofre!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun avain on valmis,\nvoit avata arkun!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la clé sera terminée,\nvous pourrez ouvrir le coffre !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah kunci selesai,\npeti bisa dibuka!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la chiave è pronta\npuoi aprire lo scrigno!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵が完成したら\n箱を開けられます!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nøkkelen er ferdig,\nkan du åpne esken!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is de sleutel klaar,\ndan kun je de kist openen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy klucz będzie gotowy,\notworzysz skrzynię!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a chave estiver pronta,\nvocê poderá abrir a caixa!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ключ готов,\nможно открыть сундук!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När nyckeln är klar\nkan du öppna lådan!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อกุญแจเสร็จ\nก็เปิดกล่องได้เลย!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar tamamlanınca\nsandığı açabilirsin!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chìa khóa hoàn thành,\nbạn có thể mở hộp!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙完成后\n就能打开箱子啦！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鑰匙完成後\n就能打開寶箱！"
          }
        }
      }
    },
    "열쇠로 상자를 열어 보물을 획득": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři klíčem truhlu a získej poklad"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn kisten med nøglen og få skatten"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Truhe mit dem Schlüssel und gewinne einen Schatz"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το κουτί με το κλειδί και κέρδισε τον θησαυρό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the box with your key and claim the treasure"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the box with your key and claim the treasure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el cofre con la llave y consigue el tesoro"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa arkku avaimella ja saa aarre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le coffre avec la clé et gagnez un trésor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka peti dengan kunci dan dapatkan harta karun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri lo scrigno con la chiave e ottieni il tesoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵で箱を開けて宝物を手に入れる"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne esken med nøkkelen og få en skatt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de kist met de sleutel en vind de schat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz skrzynię kluczem i zdobądź skarb"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
