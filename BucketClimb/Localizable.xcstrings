    "열쇠 = 꿈을 이루는 과정": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč = cesta ke splnění snu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøgle = vejen til din drøm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel = der Weg zum Traum"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλειδί = η διαδρομή προς το όνειρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key = your path to the dream"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Key = your path to the dream"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llave = el camino hacia tu sueño"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avain = unelman toteutuminen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé = le chemin vers votre rêve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci = proses mewujudkan mimpi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave = il percorso per realizzare il sogno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵 = 夢を叶える道のり"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkel = veien til drømmen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutel = de weg naar je droom"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz = droga do spełnienia marzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave = o caminho até o sonho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ = путь к мечте"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckel = vägen till din dröm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจ = เส้นทางสู่ความฝัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar = hayale giden süreç"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chìa khóa = hành trình thực hiện ước mơ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
