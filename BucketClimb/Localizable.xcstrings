    "하나씩 꽃피워 나가볼까요?": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Necháme je rozkvétat jeden po druhém?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal vi få dem til at blomstre én efter én?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen wir einen nach dem anderen erblühen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να τα ανθίσουμε ένα ένα;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we bring them to bloom, one by one?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we bring them to bloom, one by one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Los hacemos florecer uno a uno?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitetaanko kukkimaan saaminen yksi kerrallaan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ferons-nous fleurir un à un ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mau mekarkan satu per satu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Li facciamo sbocciare uno alla volta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつずつ咲かせていきましょうか?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal vi la dem blomstre én etter én?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zullen we ze één voor één laten bloeien?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozkwitniemy po jednym?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos fazer florescer um a um?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давайте расцветим их одну за другой?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ska vi låta dem blomma en i taget?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาทำให้บานทีละดวงกันไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teker teker çiçek açtıralım mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng làm nở từng ước mơ nhé?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们一个一个让它们绽放吧？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一朵一朵讓它們盛開吧？"
          }
        }
      }
    },
    "하나씩 이루어가는 순간들이 모여 꽃이 됩니다": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z jednotlivých splněných okamžiků vzniká květ"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øjeblikke, der opfyldes én efter én, bliver til en blomst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moment für Moment, Schritt für Schritt wird daraus eine Blüte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι στιγμές που πραγματοποιούνται μία μία γίνονται λουλούδι"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each moment you achieve blossoms into a flower"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each moment you achieve blossoms into a flower"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los momentos que cumples uno a uno se convierten en una flor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kerrallaan toteutuvista hetkistä kasvaa kukka"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les moments réalisés un à un deviennent une fleur"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Momen-momen yang terwujud satu per satu menjadi bunga"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I momenti realizzati uno a uno diventano un fiore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつずつ叶えていく瞬間が集まって花になります"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øyeblikkene du oppfyller ett etter ett, blir til en blomst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moment voor moment worden ze samen een bloem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwile spełniane jedna po drugiej składają się na kwiat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os momentos realizados, um a um, se tornam uma flor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновения, которые вы проживаете одно за другим, складываются в цветок"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ögonblick som uppfylls ett i taget blir en blomma"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาที่ทำสำเร็จทีละอย่างรวมกันเป็นดอกไม้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tek gerçekleşen anlar birleşip çiçek olur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những khoảnh khắc thực hiện từng chút một sẽ nở thành hoa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一点一点实现的瞬间，汇聚成一朵花"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個個實現的時刻，匯聚成一朵花"
          }
        }
      }
    },
