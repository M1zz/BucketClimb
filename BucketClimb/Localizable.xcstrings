    "이 꿈을 이루면\n어떤 기분일 것 같아요?": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaký to bude pocit,\naž se tento sen splní?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan ville det føles,\nhvis du opfyldte denne drøm?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie fühlt es sich an,\nwenn dieser Traum wahr wird?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν πραγματοποιήσεις αυτό το όνειρο,\nπώς νομίζεις ότι θα νιώθεις;"
