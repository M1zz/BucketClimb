          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stwórz własnoręcznie\nklucz do skrzyni marzeń"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
