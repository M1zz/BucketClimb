    "정말 이 꿈을 이루셨나요?\n이 순간을 함께 축하해요!": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu se ti tento sen splnil?\nOslavme tu chvíli spolu!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du virkelig opfyldt denne drøm?\nLad os fejre øjeblikket sammen!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du diesen Traum wirklich erfüllt?\nFeiern wir diesen Moment gemeinsam!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πραγματοποίησες αλήθεια αυτό το όνειρο;\nΑς γιορτάσουμε μαζί αυτή τη στιγμή!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you really achieve this dream?\nLet's celebrate together!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you really achieve this dream?\nLet's celebrate together!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De verdad cumpliste este sueño?\n¡Celebremos este momento juntos!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toteutitko todella tämän unelman?\nJuhlitaan tätä hetkeä yhdessä!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous vraiment réalisé ce rêve ?\nCélébrons ensemble ce moment !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkah mimpi ini sudah terwujud?\nMari rayakan momen ini bersama!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai davvero realizzato questo sogno?\nFesteggiamo insieme questo momento!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当にこの夢を叶えましたか?\nこの瞬間を一緒にお祝いしましょう!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du virkelig oppfylt denne drømmen?\nLa oss feire øyeblikket sammen!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je deze droom echt bereikt?\nLaten we dit moment samen vieren!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawdę spełniło się to marzenie?\nŚwiętujmy tę chwilę razem!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você realmente realizou este sonho?\nVamos comemorar este momento juntos!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы правда осуществили эту мечту?\nДавайте отпразднуем этот миг вместе!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du verkligen uppfyllt drömmen?\nLåt oss fira ögonblicket tillsammans!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทำความฝันนี้สำเร็จจริงๆ ใช่ไหม\nมาฉลองช่วงเวลานี้ด้วยกัน!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hayali gerçekten gerçekleştirdin mi?\nBu anı birlikte kutlayalım!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thật sự đã thực hiện được ước mơ này?\nCùng ăn mừng khoảnh khắc này nhé!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你真的实现了这个梦想吗？\n一起庆祝这一刻吧！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你真的實現這個夢想了嗎？\n一起來慶祝這一刻吧！"
          }
        }
      }
    },
