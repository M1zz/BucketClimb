    "가슴 뛰는 무언가를 떠올려보세요\n그것이 바로 당신의 첫 번째 꿈이 될 거예요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzpomeň si na něco, z čeho ti buší srdce\nTo bude tvůj první sen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænk på noget, der får dit hjerte til at banke\nDet bliver din allerførste drøm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk an etwas, das dein Herz höherschlagen lässt.\nDas wird dein erster Traum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκέψου κάτι που σου κάνει την καρδιά να χτυπά δυνατά\nΑυτό θα είναι το πρώτο σου όνειρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of something that makes your heart race\nThat will be your very first dream"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of something that makes your heart race\nThat will be your very first dream"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piensa en algo que te haga vibrar\nEse será tu primer sueño"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieti jotain, mikä saa sydämesi hakkaamaan\nSe on ensimmäinen unelmasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à quelque chose qui vous fait vibrer\nCe sera votre premier rêve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayangkan sesuatu yang membuat hatimu berdebar\nItulah yang akan jadi mimpi pertamamu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensa a qualcosa che ti fa battere il cuore\nSarà il tuo primo sogno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワクワクすることを思い浮かべてみましょう\nそれがあなたの最初の夢になります"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenk på noe som får hjertet til å banke\nDet blir din aller første drøm"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk aan iets waar je hart sneller van gaat kloppen\nDat is meteen je eerste droom"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomyśl o czymś, co przyspiesza Ci tętno\nTo będzie Twoje pierwsze marzenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pense em algo que faça seu coração disparar.\nEsse será o seu primeiro sonho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вспомните то, от чего замирает сердце\nЭто и станет вашей первой мечтой"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänk på något som får hjärtat att slå snabbare\nDet blir din första dröm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองนึกถึงสิ่งที่ทำให้ใจเต้นแรง\nนั่นแหละคือความฝันแรกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbini heyecanlandıran bir şey düşün\nİşte ilk hayalin o olacak"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nghĩ đến điều khiến tim bạn rộn ràng\nĐó sẽ là ước mơ đầu tiên của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想一件让你心动的事吧\n它就是你的第一个梦想"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想想那件讓你心跳加速的事\n它就會是你的第一個夢想"
          }
        }
      }
    },
    "각 꿈마다 고유한 열쇠가 필요해요": {
