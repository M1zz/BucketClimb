            "state": "translated",
            "value": "Bucket List'e madde eklerken yer aratabilirsin!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thêm vào bucket list, hãy thử tìm địa điểm nhé!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加心愿清单时，试试搜索地点吧！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增願望清單時，試著搜尋地點吧！"
          }
        }
      }
    },
    "버킷리스트에 담으면 나만의 마일스톤을 설정하고 꿈을 향해 한 걸음씩 나아갈 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když si sen přidáš do bucket listu, můžeš si nastavit vlastní milníky a jít za ním krok za krokem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du lægger det på din bucket list, kan du sætte dine egne milepæle og gå et skridt ad gangen mod drømmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Traum zu deiner Bucket List hinzufügst, kannst du eigene Meilensteine setzen und Schritt für Schritt vorangehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το προσθέσεις στη λίστα επιθυμιών, μπορείς να ορίσεις δικά σου ορόσημα και να προχωράς βήμα βήμα προς το όνειρό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add it to your bucket list to set your own milestones and move toward your dream one step at a time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add it to your bucket list to set your own milestones and move toward your dream one step at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadirlo a tu lista de deseos, podrás fijar tus propios hitos y avanzar paso a paso hacia tu sueño."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun lisäät unelman listalle, voit asettaa omat merkkipaalusi ja edetä askel kerrallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'ajoutant à votre bucket list, fixez vos propres étapes clés et avancez pas à pas vers votre rêve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan menambahkannya ke bucket list, kamu bisa mengatur tonggakmu sendiri dan melangkah menuju mimpimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la aggiungi alla bucket list, puoi fissare i tuoi traguardi e avvicinarti al sogno un passo alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バケットリストに追加すると、自分だけのマイルストーンを設定して、夢に向かって一歩ずつ進めます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du legger det til i bucket listen, kan du sette dine egne delmål og gå mot drømmen ett skritt om gangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een droom aan je bucketlist toevoegt, stel je je eigen mijlpalen in en kom je stap voor stap dichter bij je droom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dodasz je do listy marzeń, ustawisz własne kamienie milowe i krok po kroku ruszysz ku marzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao guardar na sua lista de desejos, você define seus marcos e avança um passo de cada vez rumo ao sonho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте мечту в список желаний, чтобы задать свои этапы и шаг за шагом идти к ней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du lägger något i din bucket list kan du sätta egna delmål och ta ett steg i taget mot drömmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเก็บเข้าบักเก็ตลิสต์ คุณจะตั้งหมุดหมายของตัวเองและก้าวไปสู่ความฝันทีละก้าวได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket List'e eklersen kendi kilometre taşlarını belirleyip hayaline adım adım yaklaşabilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thêm vào bucket list, bạn có thể đặt cột mốc riêng và tiến từng bước tới ước mơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入心愿清单后，就可以设置专属里程碑，朝着梦想一步一步前进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放進願望清單後，就能設定專屬里程碑，朝著夢想一步步前進。"
          }
        }
      }
    },
