    "꿈 상자를 열 열쇠를\n직접 만들어보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoř si vlastní klíč,\nkterý otevře truhlu snů"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav selv nøglen\ntil din drømmekiste"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau dir den Schlüssel,\nder deine Traumtruhe öffnet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάξε μόνος σου το κλειδί\nγια να ανοίξεις το κουτί του ονείρου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Craft the key\nthat opens your dream box"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Craft the key\nthat opens your dream box"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tú mismo la llave\npara abrir tu cofre de sueños"
          }
        },
