          "stringUnit": {
            "state": "translated",
            "value": "Tee itse avain,\njoka avaa unelma-arkun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fabriquez vous-même la clé\nqui ouvrira votre coffre de rêve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat sendiri kunci\nuntuk membuka peti mimpimu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci tu stesso la chiave\nper aprire lo scrigno dei sogni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
