    "장애물 진행에 따라 등반 거리가 자동으로 계산됩니다!": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdálenost výstupu se počítá automaticky podle postupu u překážek!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatreafstanden beregnes automatisk ud fra forhindringernes fremskridt!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufstiegsstrecke wird automatisch aus dem Fortschritt bei den Hindernissen berechnet!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόσταση ανάβασης υπολογίζεται αυτόματα από την πρόοδο των εμποδίων!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Climb distance is calculated automatically from obstacle progress!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Climb distance is calculated automatically from obstacle progress!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia escalada se calcula automáticamente según el avance en los obstáculos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nousumatka lasketaan automaattisesti esteiden edistymisestä!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance d'ascension se calcule automatiquement selon vos obstacles !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak pendakian dihitung otomatis dari progres rintangan!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza scalata viene calcolata in automatico in base ai progressi sugli ostacoli!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "障害の進み具合に応じて、登った距離が自動で計算されます!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatredistansen beregnes automatisk ut fra framdriften på hindringene!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je klimafstand wordt automatisch berekend op basis van je voortgang bij obstakels!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dystans wspinaczki liczy się automatycznie według postępu przeszkód!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância da escalada é calculada automaticamente conforme o avanço nos obstáculos!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота подъёма считается автоматически по прогрессу препятствий!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klättrat avstånd räknas ut automatiskt utifrån hindren!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะที่ปีนจะคำนวณอัตโนมัติตามความคืบหน้าของอุปสรรค!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tırmanış mesafesi, engellerdeki ilerlemeye göre otomatik hesaplanır!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quãng đường leo được tự động tính theo tiến trình vượt trở ngại!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "攀登距离会根据障碍的进展自动计算！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "障礙進度會自動計算攀登距離！"
          }
        }
      }
    },
