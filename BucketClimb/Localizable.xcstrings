    "언젠가 꼭 하고 싶은 것,\n상상만 해도 설레는 그것을 적어주세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš, co jednou určitě chceš udělat\na z čeho ti buší srdce, už když si to představíš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget, du en dag vil gøre,\nog som får dig til at glæde dig bare ved tanken"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas, das du unbedingt einmal tun willst,\nund bei dem dir schon beim Gedanken das Herz aufgeht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι που θες οπωσδήποτε να κάνεις κάποτε,\nκάτι που σε συγκινεί και μόνο στη σκέψη, γράψε το"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something you want to do someday,\nsomething that thrills you just thinking about it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something you want to do someday,\nsomething that thrills you just thinking about it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso que siempre has querido hacer,\nescribe lo que te ilusiona solo con imaginarlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotain, mitä haluat joskus tehdä,\nja mikä jännittää jo ajatuksena. Kirjoita se tähän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous rêvez de faire un jour,\nce qui vous fait vibrer rien que d'y penser : écrivez-le"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu yang suatu hari pasti ingin kamu lakukan,\ntulis hal yang membuat hatimu berdebar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa che vuoi fare prima o poi,\nche ti emoziona solo a immaginarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつかやりたいこと、\n想像するだけでワクワクすることを書いてください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe du virkelig vil gjøre en dag,\nsom gir deg sommerfugler bare ved tanken. Skriv det ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets wat je ooit echt wilt doen,\nwaar je alleen al van gaat glunderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś, co kiedyś koniecznie chcesz zrobić,\nco ekscytuje już na samą myśl. Wpisz to tutaj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que você quer muito fazer um dia,\nque só de imaginar já empolga. Escreva aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, чего вы однажды обязательно хотите,\nот одной мысли о чём замирает сердце. Запишите это"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ner något du vill göra någon gång,\nsom det bara är spännande att tänka på"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่อยากทำสักวันให้ได้\nแค่คิดก็ใจเต้น เขียนลงไปได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gün mutlaka yapmak istediğin,\nhayal etmesi bile heyecan verici şeyi yaz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy viết ra điều bạn nhất định muốn làm một ngày nào đó,\nchỉ nghĩ thôi đã thấy háo hức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总有一天一定要做的事，\n光是想想就心动的事，写下来吧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時想做的事，\n光是想像就心動的事，寫下來吧"
          }
        }
      }
    },
