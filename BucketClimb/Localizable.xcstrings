    "목표를 추가합니다. 가능하면 작은 첫 단계로 나눠 함께 추가합니다." : {
      "comment" : "Siri: add goal description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá cíl. Pokud je to možné, rozdělí ho na malé první kroky a přidá je spolu s ním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer et mål. Hvis det er muligt, deles det op i små første trin, som tilføjes samtidig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt ein Ziel hinzu. Wenn möglich, wird es in kleine erste Schritte aufgeteilt, die mit hinzugefügt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει έναν στόχο. Όταν είναι εφικτό, τον χωρίζει σε μικρά πρώτα βήματα και τα προσθέτει μαζί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a goal. When possible, it is broken into small first steps that are added with it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a goal. When possible, it is broken into small first steps that are added with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una meta. Si es posible, se divide en pequeños primeros pasos que se añaden a la vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tavoitteen. Jos mahdollista, se jaetaan pieniin ensimmäisiin vaiheisiin, jotka lisätään samalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un objectif. Si possible, il est divisé en petites premières étapes ajoutées en même temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan target. Jika memungkinkan, target dibagi menjadi langkah awal yang kecil dan ditambahkan bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un obiettivo. Se possibile, lo divide in piccoli primi passaggi aggiunti insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標を追加します。可能な場合は、小さな最初のステップに分けて一緒に追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표를 추가합니다. 가능하면 작은 첫 단계로 나눠 함께 추가합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til et mål. Når det er mulig, deles det inn i små første trinn som legges til samtidig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een doel toe. Indien mogelijk wordt het verdeeld in kleine eerste stappen die mee worden toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje cel. Jeśli to możliwe, dzieli go na małe pierwsze kroki i dodaje je razem z nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
