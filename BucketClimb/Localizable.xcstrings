    "💡 예: '오로라 시즌 (9-3월)', '벚꽃 시기'": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Např.: „sezóna polární záře (září–březen)“, „doba kvetení sakur“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 F.eks. \"Nordlyssæson (sep-mar)\", \"Kirsebærblomstring\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 z. B. 'Polarlichtsaison (Sept.–März)', 'Kirschblütenzeit'"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 π.χ. «Εποχή του σέλας (Σεπ-Μάρ)», «Εποχή των ανθισμένων κερασιών»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 e.g. 'Aurora season (Sep–Mar)', 'Cherry blossom season'"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 e.g. 'Aurora season (Sep–Mar)', 'Cherry blossom season'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Ej.: «temporada de auroras (sept.-marzo)», «época de los cerezos en flor»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Esim. \"revontulikausi (syys-maaliskuu)\", \"kirsikankukinta-aika\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Ex. : « saison des aurores (sept.-mars) », « floraison des cerisiers »"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Contoh: 'musim aurora (Sep-Mar)', 'musim sakura'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Es.: 'stagione dell'aurora (set-mar)', 'fioritura dei ciliegi'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 例: 「オーロラシーズン(9〜3月)」「桜の時期」"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 F.eks.: «nordlyssesongen (sept.–mars)», «kirsebærblomstring»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Bijv. 'Noorderlichtseizoen (sep-mrt)', 'kersenbloesemtijd'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Np. „sezon zórz polarnych (wrzesień-marzec)”, „kwitnienie wiśni”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Ex.: 'Temporada de aurora (set-mar)', 'Época das cerejeiras'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Например: «сезон северного сияния (сентябрь–март)», «время цветения сакуры»"
          }
        },
        "sv": {
          "stringUnit": {
