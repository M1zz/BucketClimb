    "수많은 꿈들이 상자에 담겨\n바다 위를 떠다니고 있어요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nespočet snů v truhlách\nplave po moři"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Utallige drømme flyder\nrundt på havet i kister"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unzählige Träume schweben\nin Truhen über das Meer"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αμέτρητα όνειρα μέσα σε κουτιά\nπλέουν πάνω στη θάλασσα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countless dreams in boxes\nare drifting across the ocean"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Countless dreams in boxes\nare drifting across the ocean"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sinfín de sueños, guardados en cofres,\nflotan sobre el mar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukemattomia unelmia kelluu\nmerellä arkuissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rêves sans nombre, dans leurs coffres,\nflottent sur l'océan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimpi tak terhitung jumlahnya\nmengapung di atas laut dalam peti"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanti sogni, chiusi negli scrigni,\nfluttuano sul mare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たくさんの夢が箱に入って\n海の上を漂っています"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utallige drømmer flyter\nrundt på havet i esker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Talloze dromen drijven\nin kisten over de oceaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezliczone marzenia płyną\nw skrzyniach po oceanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incontáveis sonhos, dentro de caixas,\nflutuam sobre o mar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесчисленные мечты в сундуках\nплывут по океану"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Otaliga drömmar flyter omkring\npå havet i sina lådor"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความฝันมากมายอยู่ในกล่อง\nลอยอยู่เหนือท้องทะเล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayısız hayal sandıklara konmuş\ndenizde süzülüyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vô số ước mơ nằm trong những chiếc hộp\ntrôi nổi trên biển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
