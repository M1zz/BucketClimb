    "아래 '시작하기' 버튼을 눌러\n첫 번째 꿈을 찾아보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepni dole na „Začít“\na najdi svůj první sen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på \"Kom i gang\" nedenfor\nog find din første drøm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten auf „Los geht's“\nund finde deinen ersten Traum"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα «Ας ξεκινήσουμε» παρακάτω\nκαι βρες το πρώτο σου όνειρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap 'Get Started' below\nto find your first dream"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap 'Get Started' below\nto find your first dream"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Empezar» abajo\ny encuentra tu primer sueño"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina alla olevaa Aloita-painiketta\nja etsi ensimmäinen unelmasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Commencer » ci-dessous\npour partir à la recherche de votre premier rêve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk 'Mulai' di bawah\nuntuk menemukan mimpi pertamamu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca 'Inizia' qui sotto\nper trovare il tuo primo sogno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「はじめる」を押して\n最初の夢を探しましょう"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «Kom i gang» nedenfor\nog finn din første drøm"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik hieronder op 'Beginnen'\nen ontdek je eerste droom"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij „Zaczynamy” poniżej\ni odszukaj swoje pierwsze marzenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Começar\" abaixo\ne descubra seu primeiro sonho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Начать» ниже\nи найдите свою первую мечту"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på 'Kom igång' nedan\nså hittar du din första dröm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่ม 'เริ่มเลย' ด้านล่าง\nแล้วค้นหาความฝันแรกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki 'Başla' düğmesine dokun\nve ilk hayalini bul"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn 'Bắt đầu' bên dưới\nđể tìm ước mơ đầu tiên của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按下方的“开始”\n去寻找你的第一个梦想吧"
          }
        },
        "zh-Hant": {
