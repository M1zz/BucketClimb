          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте сундук ключом и получите сокровище"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna lådan med nyckeln och få skatten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดกล่องด้วยกุญแจเพื่อรับสมบัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarla sandığı açıp hazineyi kazan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở hộp bằng chìa khóa để nhận kho báu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
