    "목표를 단계로 나누고, 하나씩 체크하며 기록합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělte cíle na kroky, postupně je odškrtávejte a přidávejte záznamy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del mål op i trin, kryds dem af et ad gangen, og før noter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele in Schritte aufteilen, einzeln abhaken und Notizen festhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χώρισε τους στόχους σε βήματα, σημείωσέ τα ένα ένα και κράτα καταγραφές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
