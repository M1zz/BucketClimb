    "💡 이 기록은 나중에 꿈을 향해 나아갈 때\n힘이 되어줄 거예요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Tento záznam ti později dodá sílu\nna cestě za snem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Denne optegnelse vil give dig styrke,\nnår du går efter drømmen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Dieser Eintrag wird dir später auf dem Weg\nzu deinem Traum Kraft geben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Αυτή η καταγραφή θα σε στηρίξει\nόταν προχωράς αργότερα προς το όνειρό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 These notes will give you strength\nas you move toward your dream"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 These notes will give you strength\nas you move toward your dream"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Este registro te dará fuerzas\nmás adelante en tu camino hacia el sueño"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Tämä merkintä antaa voimaa\nmyöhemmin matkalla kohti unelmaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Cette note vous donnera de la force\nquand vous avancerez vers votre rêve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Catatan ini akan jadi penyemangat\nsaat kamu melangkah menuju mimpimu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Questa nota ti darà forza più avanti\nlungo la strada verso il tuo sogno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 この記録は、あとで夢に向かって進むとき\n力になってくれます"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Denne loggen vil gi deg\nstyrke senere på veien mot drømmen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Dit verslag geeft je later kracht\nop weg naar je droom"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Ten zapis doda Ci sił\nw drodze do marzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Este registro vai te dar força\nmais tarde, na caminhada rumo ao sonho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Эта запись поддержит вас\nна пути к мечте"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Den här anteckningen ger dig\nkraft längre fram mot drömmen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 บันทึกนี้จะเป็นกำลังใจให้คุณ\nเมื่อก้าวไปสู่ความฝันในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Bu kayıt, hayaline ilerlerken\nsana güç verecek"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 Ghi chép này sẽ tiếp sức cho bạn\nkhi tiến về phía ước mơ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 日后朝着梦想前进时\n这条记录会给你力量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 這筆記錄在之後朝夢想前進時\n會成為你的力量"
          }
        }
      }
    },
