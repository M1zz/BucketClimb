    "꿈의 바다에서 상자를 가져와 열쇠를 만들어보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezmi si z oceánu snů truhlu a vytvoř klíč"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent en kiste fra Drømmehavet og lav en nøgle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir eine Truhe aus dem Traumozean und bau den Schlüssel dazu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρε ένα κουτί από τον Ωκεανό των Ονείρων και φτιάξε το κλειδί του"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring a box from the Dream Ocean and craft its key"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring a box from the Dream Ocean and craft its key"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un cofre del Océano de sueños y crea su llave"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae arkku unelmien merestä ja tee sille avain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un coffre dans l'océan des rêves et fabriquez sa clé"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil peti dari Laut Mimpi dan buat kuncinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi uno scrigno dal Mare dei sogni e costruisci la tua chiave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢の海から箱を持ち帰って、鍵を作ってみましょう"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent en eske fra Drømmehavet og lag en nøkkel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal een kist uit de droomoceaan en maak er een sleutel voor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabierz skrzynię z oceanu marzeń i stwórz do niej klucz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue uma caixa no Mar de Sonhos e crie sua chave"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмите сундук из океана мечтаний и создайте ключ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta en låda från Drömhavet och skapa en nyckel"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำกล่องจากทะเลแห่งความฝันมาสร้างกุญแจกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayal Okyanusu'ndan bir sandık al ve anahtarını yap"
          }
        },
        "vi": {
