    "이제 당신만의 꿈을\n열쇠로 만들어볼 시간이에요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je čas přetvořit\nsvůj sen v klíč"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu er det tid til at gøre\ndin egen drøm til en nøgle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt ist es Zeit, aus deinem Traum\neinen Schlüssel zu bauen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ώρα να κάνεις το δικό σου όνειρο\nκλειδί"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now it's time to turn\nyour dream into a key"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Now it's time to turn\nyour dream into a key"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora toca convertir\ntu sueño en una llave"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt on aika tehdä\nomasta unelmastasi avain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le moment de transformer\nvotre propre rêve en clé"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatnya mengubah mimpimu sendiri\njadi kunci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora è il momento di trasformare\nil tuo sogno in una chiave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さあ、あなただけの夢を\n鍵にしてみましょう"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå er det på tide å gjøre\ndin egen drøm til en nøkkel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd om van je eigen droom\neen sleutel te maken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas zamienić\nswoje marzenie w klucz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora é hora de transformar\no seu sonho em chave"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пора превратить вашу мечту\nв ключ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu är det dags att förvandla\ndin dröm till en nyckel"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงเวลาเปลี่ยนความฝันของคุณ\nให้เป็นกุญแจแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi sana özel hayalini\nanahtara dönüştürme zamanı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đến lúc biến ước mơ của riêng bạn\nthành chiếc chìa khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在是时候\n把你自己的梦想变成钥匙了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，該把你專屬的夢想\n做成鑰匙了"
          }
        }
      }
    },
