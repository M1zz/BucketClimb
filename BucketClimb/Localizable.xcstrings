    "꿈을 이루기 위한 설레는 단계들을 상상해보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Představ si, jaké vzrušující kroky tě k tvému snu dovedou"
