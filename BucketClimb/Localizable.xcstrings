    "당신만의 특별한 꿈이 있나요?": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máš nějaký svůj zvláštní sen?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du en helt særlig drøm?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du einen ganz besonderen Traum?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ένα δικό σου ξεχωριστό όνειρο;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have a dream all your own?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have a dream all your own?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tienes un sueño muy tuyo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko sinulla ihan oma unelma?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous un rêve bien à vous ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Punya mimpi yang istimewa untukmu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai un sogno tutto tuo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなただけの特別な夢はありますか?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du en helt spesiell drøm?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je een heel eigen droom?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz jakieś wyjątkowe marzenie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem um sonho só seu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть ли у вас особая мечта?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du en alldeles egen dröm?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณมีความฝันที่เป็นของคุณเองไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana özel bir hayalin var mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có ước mơ đặc biệt của riêng mình không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有属于自己的特别梦想吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你有屬於自己的特別夢想嗎？"
          }
        }
      }
    },
    "당신은 이미 %lld개의 꿈을 피워냈어요!": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už jsi nechal(a) rozkvést sny: %lld!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede fået %lld drømme til at blomstre!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast schon %lld Träume zum Blühen gebracht!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ήδη κάνει %lld όνειρα να ανθίσουν!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already brought %lld dreams to bloom!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already brought %lld dreams to bloom!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Ya has hecho florecer %lld sueños!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo saanut %lld unelmaa kukkimaan!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà fait fleurir %lld rêves !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah mewujudkan %lld mimpi!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già fatto sbocciare %lld sogni!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはすでに%lld個の夢を咲かせました!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede fått %lld drømmer til å blomstre!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al %lld dromen laten bloeien!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spełnione marzenia: %lld!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já fez %lld sonhos florescerem!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже вырастили мечтаний: %lld!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan fått %lld drömmar att blomma!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทำความฝันให้บานแล้ว %lld ดวง!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiden %lld hayali çiçeklendirdin!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã làm nở %lld ước mơ rồi!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经让 %lld 个梦想绽放了！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經讓 %lld 個夢想開花了！"
          }
        }
      }
    },
    "당신의 꿈을 열쇠로 만들어\n보물상자를 열어보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetvoř své sny v klíče\na otevři truhly s pokladem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør din drøm til en nøgle\nog åbn skatkisten"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus deinem Traum einen Schlüssel\nund öffne die Schatztruhe"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε το όνειρό σου κλειδί\nκαι άνοιξε το σεντούκι του θησαυρού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your dreams into keys\nand open your treasure boxes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your dreams into keys\nand open your treasure boxes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte tu sueño en una llave\ny abre el cofre del tesoro"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee unelmastasi avain\nja avaa aarrearkku"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez votre rêve en clé\net ouvrez le coffre au trésor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah mimpimu jadi kunci\ndan buka peti harta"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il tuo sogno in una chiave\ne apri lo scrigno del tesoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの夢を鍵にして\n宝箱を開けましょう"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør drømmen din til en nøkkel\nog åpne skatteskrinet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van je droom een sleutel\nen open de schatkist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień swoje marzenie w klucz\ni otwórz skrzynię ze skarbem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme seu sonho em chave\ne abra a caixa de tesouro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте ключ из своей мечты\nи откройте сундук с сокровищами"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förvandla din dröm till en nyckel\noch öppna skattkistan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนความฝันเป็นกุญแจ\nแล้วเปิดหีบสมบัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayalini anahtara dönüştür\nve hazine sandığını aç"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến ước mơ của bạn thành chìa khóa\nvà mở hộp kho báu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的梦想变成钥匙\n打开宝箱吧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的夢想做成鑰匙\n打開寶箱吧"
          }
        }
      }
    },
    "당신의 꿈이 밤하늘의 풍등처럼\n아름답게 빛나고 있어요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj sen září krásně jako\nlampión na noční obloze"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din drøm lyser smukt\nsom en himmellanterne på nattehimlen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Traum leuchtet wunderschön\nwie eine Himmelslaterne in der Nacht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνειρό σου λάμπει όμορφα\nσαν φανάρι στον νυχτερινό ουρανό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your dreams are glowing like\nlanterns in the night sky"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your dreams are glowing like\nlanterns in the night sky"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sueño brilla hermoso\ncomo un farolillo en el cielo nocturno"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unelmasi loistaa yötaivaalla\nkuin lyhtyjen valo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rêve brille dans la nuit\ncomme une lanterne céleste"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimpimu bersinar indah\nseperti lentera di langit malam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo sogno brilla meravigliosamente\ncome una lanterna nel cielo notturno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの夢が夜空のランタンのように\n美しく輝いています"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Drømmen din lyser vakkert\nsom en lanterne mot nattehimmelen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dromen stralen prachtig\nals lantaarns aan de nachthemel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje marzenie lśni pięknie\njak lampion na nocnym niebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu sonho brilha lindamente\ncomo uma lanterna no céu noturno"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша мечта сияет в ночном небе,\nкак праздничный фонарик"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din dröm lyser vackert\nsom en himmelslykta mot natthimlen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความฝันของคุณส่องสว่างสวยงาม\nเหมือนโคมลอยบนท้องฟ้ายามค่ำคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayalin gece göğündeki bir gökyüzü feneri gibi\ngüzelce parlıyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước mơ của bạn tỏa sáng đẹp đẽ\nnhư đèn trời giữa bầu trời đêm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的梦想像夜空中的孔明灯\n美丽地闪耀着"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的夢想像夜空中的天燈\n閃耀著美麗的光芒"
          }
        }
      }
    },
