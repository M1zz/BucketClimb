    "요금제를 불러오지 못했어요. 인터넷 연결을 확인하고 다시 시도해 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plány se nepodařilo načíst. Zkontrolujte připojení k internetu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planerne kunne ikke indlæses. Tjek din internetforbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne konnten nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση των πλάνων. Έλεγξε τη σύνδεσή σου στο διαδίκτυο και δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t load plans. Check your internet connection and try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t load plans. Check your internet connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los planes. Comprueba tu conexión a internet y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilauksia ei voitu ladata. Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les formules. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket tidak dapat dimuat. Periksa koneksi internet lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare i piani. Controlla la connessione a Internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランを読み込めませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste inn planene. Sjekk internettforbindelsen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De abonnementen konden niet worden geladen. Controleer je internetverbinding en probeer het opnieuw."
