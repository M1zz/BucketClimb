    "이 꿈과 함께한 모든 기록이 사라져요.\n정말 괜찮으신가요?": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny záznamy k tomuto snu zmizí.\nOpravdu to chceš?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle optegnelser fra denne drøm forsvinder.\nEr du helt sikker?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge zu diesem Traum gehen verloren.\nBist du sicher?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι καταγραφές αυτού του ονείρου θα χαθούν.\nΕίσαι σίγουρος;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every record of this dream will be lost.\nAre you sure?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every record of this dream will be lost.\nAre you sure?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los registros de este sueño desaparecerán.\n¿Seguro que quieres continuar?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän unelman merkinnät katoavat.\nOletko varma?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les traces de ce rêve disparaîtront.\nEn êtes-vous sûr ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua catatan bersama mimpi ini akan hilang.\nKamu yakin?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le note legate a questo sogno andranno perse.\nSei sicuro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夢と歩んだ記録がすべて消えます。\n本当によろしいですか?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "All loggen du har ført for denne drømmen forsvinner.\nEr du sikker?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je met deze droom hebt vastgelegd verdwijnt.\nWeet je het zeker?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znikną wszystkie zapisy związane z tym marzeniem.\nNa pewno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os registros deste sonho serão perdidos.\nTem certeza?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все записи об этой мечте пропадут.\nВы уверены?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla anteckningar om drömmen försvinner.\nÄr du säker?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกทั้งหมดของความฝันนี้จะหายไป\nแน่ใจนะ"
