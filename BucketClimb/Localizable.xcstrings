    "'%@' 꿈을 내 창고로 다시 가져갑니다.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen „%@“ se vrací do tvé dílny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du henter drømmen \"%@\" tilbage til dit værksted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Traum '%@' kommt zurück in deine Werkstatt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνειρο «%@» επιστρέφει στο εργαστήρι σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' will move back to My Workshop."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' will move back to My Workshop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volverás a llevar el sueño «%@» a tu taller."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unelma \"%@\" palaa takaisin työpajaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rêve « %@ » retourne dans votre atelier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimpi '%@' akan dibawa kembali ke gudangmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporti il sogno '%@' nella tua officina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の夢をマイ工房に戻します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Drømmen «%@» tas med tilbake til verkstedet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' gaat terug naar je werkplaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabierasz marzenie „%@” z powrotem do swojego warsztatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sonho '%@' voltará para a sua oficina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мечта «%@» вернётся в вашу мастерскую."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drömmen '%@' flyttas tillbaka till din verkstad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำความฝัน '%@' กลับไปที่คลังของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' hayalini Atölyem'e geri alıyorsun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mang ước mơ '%@' trở lại xưởng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把「%@」这个梦想重新带回我的工坊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」這個夢想將重新帶回我的工坊。"
          }
        }
      }
    },
    "'%@' 꿈을 보물창고에 보관합니다. 나중에 다시 시작하거나 완전히 삭제할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen „%@“ se uloží do pokladnice. Můžeš ho později znovu začít nebo úplně smazat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drømmen \"%@\" lægges i skatkammeret. Du kan starte den igen senere eller slette den helt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Traum '%@' wird in der Schatzkammer aufbewahrt. Du kannst ihn später neu starten oder ganz löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνειρο «%@» θα φυλαχτεί στο θησαυροφυλάκιο. Μπορείς να το ξεκινήσεις ξανά αργότερα ή να το διαγράψεις οριστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' will be stored in your Treasury. You can restart it later or delete it for good."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' will be stored in your Treasury. You can restart it later or delete it for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sueño «%@» se guardará en el tesoro. Podrás retomarlo más tarde o eliminarlo para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unelma \"%@\" siirretään aarrekammioon. Voit aloittaa sen myöhemmin uudelleen tai poistaa sen kokonaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rêve « %@ » sera rangé dans vos trésors. Vous pourrez le reprendre plus tard ou le supprimer définitivement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimpi '%@' akan disimpan di brankas. Kamu bisa memulainya lagi nanti atau menghapusnya sepenuhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il sogno '%@' nel tesoro. Potrai riprenderlo più tardi o eliminarlo del tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の夢を宝物庫に保管します。あとで再開することも、完全に削除することもできます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Drømmen «%@» legges i skattkammeret. Du kan starte på nytt senere eller slette den helt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' wordt in de schatkamer bewaard. Je kunt later opnieuw beginnen of de droom definitief verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Marzenie „%@” trafi do skarbca. Możesz je później wznowić albo całkiem usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sonho '%@' será guardado no Tesouro. Você pode retomá-lo depois ou excluí-lo de vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мечта «%@» отправится в сокровищницу. Позже вы сможете начать её снова или удалить насовсем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drömmen '%@' läggs i skattkammaren. Du kan starta om den senare eller radera den helt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บความฝัน '%@' ไว้ในคลังสมบัติ เริ่มใหม่หรือลบทิ้งถาวรได้ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' hayalini Hazinem'e kaldırıyorsun. Daha sonra yeniden başlayabilir ya da tamamen silebilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cất ước mơ '%@' vào kho báu. Sau này bạn có thể bắt đầu lại hoặc xóa hẳn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把「%@」这个梦想存入宝库。之后可以重新开始，也可以彻底删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」這個夢想將收進寶藏庫，之後可以重新開始，也可以永久刪除。"
          }
        }
      }
    },
    "'%@' 꿈을 완전히 삭제합니다. 이 작업은 되돌릴 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen „%@“ se úplně smaže. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drømmen \"%@\" slettes helt. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Traum '%@' wird endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνειρο «%@» θα διαγραφεί οριστικά. Αυτή η ενέργεια δεν αναιρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' will be deleted for good. This can't be undone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' will be deleted for good. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sueño «%@» se eliminará para siempre. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unelma \"%@\" poistetaan kokonaan. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rêve « %@ » sera supprimé définitivement. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimpi '%@' akan dihapus sepenuhnya. Tindakan ini tidak bisa dibatalkan."
