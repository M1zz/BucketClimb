    "진행 과정을 기록하고\n사진과 함께 추억을 남겨보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávej postup\na uchovej vzpomínky s fotkami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer dine fremskridt\nog gem minderne med billeder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deinen Fortschritt fest\nund bewahre Erinnerungen mit Fotos auf"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατάγραψε την πορεία σου\nκαι κράτα αναμνήσεις με φωτογραφίες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your progress\nand keep memories with photos"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your progress\nand keep memories with photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu progreso\ny guarda recuerdos con fotos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa edistymistäsi ja\ntallenna muistot kuvien kanssa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez votre progression\net gardez des souvenirs en photos"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat prosesmu dan\nabadikan kenangan bersama foto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i progressi\ne conserva i ricordi con le foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進捗を記録して\n写真と一緒に思い出を残しましょう"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggfør framdriften\nog bevar minnene med bilder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg je voortgang vast\nen bewaar herinneringen met foto's"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj postępy\ni zachowaj wspomnienia ze zdjęciami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu progresso\ne guarde memórias com fotos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте прогресс\nи сохраняйте воспоминания с фото"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckna dina framsteg och\nspara minnen med foton"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกความคืบหน้า\nแล้วเก็บความทรงจำไว้พร้อมรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeni kaydet\nve fotoğraflarla anılar biriktir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại tiến trình\nvà lưu kỷ niệm cùng ảnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录进展过程\n用照片留下回忆吧"
          }
